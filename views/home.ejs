<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members Only Home</title>
  </head>
  <body>
    <h1>Members Only Message Board</h1>
    <% if (firstname) { %>
    <p>Welcome <%= firstname %> <%= lastname %>!</p>
    <% } else { %>
    <a href="/log-in">Log In</a>
    <a href="/sign-up">Sign Up</a>
    <% } %>
    <% if (!member) {%>
    <a href="/code">Full Membership</a>
    <% } %>
    <% if (member) { %>
    <a href="/message">Post New Message</a>
    <% } %>
    <% if (firstname) {%>
    <a href="/log-out">Log Out</a>
    <% } %>
    <h3>Messages:</h3>
    <ol>
      <% if (messages.length === 0) {%>
        <p>No messages yet.</p>
        <% } else { %>
      <% messages.forEach(msg => { %>
        <p style="font-weight: bold;"><%= member ? (msg.firstname + " " + msg.lastname)  : "Anonymous" %> - <%= msg.title %> (<%= msg.date %>)</p>
        <p><%= msg.message %></p>
      <%}); %>
      <% } %>
    </ol>
  </body>
</html>